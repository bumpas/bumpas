---
// PortfolioShowcase.astro - Grid layout for featured projects
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";

interface Project {
  id: string;
  title: string;
  description: string;
  image?: string;
  skills?: string[];
  impact?: Array<{ label: string; value: string }>;
  link?: string;
  featured?: boolean;
}

interface Props {
  projects?: Project[];
  homepage?: boolean;
}

// Fetch projects from content collection
const allProjects = await getCollection("projects");

// Transform collection data to Project interface
const collectionProjects = allProjects
  .sort((a, b) => {
    // Sort featured projects first, then by date
    if (a.data.featured !== b.data.featured) {
      return (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0);
    }
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    description: entry.data.description,
    image: entry.data.image,
    skills: entry.data.skills,
    impact: entry.data.impact,
    link: `/projects/${entry.id}`,
    featured: entry.data.featured,
  }));

// Use provided projects or fall back to collection
const { projects = collectionProjects, homepage = false } = Astro.props;

// Limit to 5 projects if on homepage
const displayProjects = homepage ? projects.slice(0, 5) : projects;
---

<section class="portfolio-showcase mb-20">
  <div class="container">
    <div class="mb-12">
      {homepage ? <h2 class="h3 mb-4">Featured Work</h2> : <h1 class="h1 mb-4">Portfolio</h1>}
      <p class="text-lg text-gray-600 max-w-2xl">
        Strategic projects that moved the needle on design systems, accessibility, and
        developer experience.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-max">
      {
        displayProjects.map((project) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            image={project.image}
            skills={project.skills}
            impact={project.impact}
            link={project.link}
            featured={project.featured}
          />
        ))
      }
    </div>
  </div>
</section>
