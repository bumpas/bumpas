---
import Base from "@/layouts/Base.astro";
import PortfolioShowcase from "@/layouts/components/PortfolioShowcase.astro";
import ExpertiseGrid from "@/layouts/components/ExpertiseGrid.astro";
---

<Base>
  <section class="banner">
    <div class="container">
      <div class="row items-center">
        <div class="md:col-8 mb-20 md:mb-0">
          <p class="font-secondary text-sm uppercase tracking-wide icon-status">Portfolio &mdash; Andrew Bumpas</p>
          <h1 class="lg:text-6xl uppercase my-8 leading-[.95em]">Ever Curious.<br/> <span class="text-secondary">Front-end Architect.</span> <br/>Design Systems.<br/> Eats Ambiguity For Breakfast. <span class="text-secondary">Gritty.</span></h1>
          <p class="pb-10">I bridge design and development — building the tokens, components, and shared language that let product teams ship consistent, accessible interfaces at scale.</p>
          <a href="/about" class="btn btn-outline-primary">Learn more</a>
          <a href="/about#resume" data-astro-reload class="btn btn-primary ml-4">Resume</a>
        </div>
      </div>
    </div>
  </section>
 
  <ExpertiseGrid />
  <PortfolioShowcase homepage={true} />

  <section class="bg-stone-700 text-light py-20 mt-20">
		<div class="container">
			<h2 class="text-light mb-2">Things I like.</h2>
		  <ul class="font-secondary text-sm tracking-wider">
        <li>fly-fishing</li>
        <li>playing mtn bikes</li>
        <li>hockey</li>
        <li>photography</li>
        <li>travel</li>
        <li>cooking</li>
        <li>coffee</li>
        <li>beer</li>
        <li>learning</li>
        <li>nature</li>
      </ul>
    </div>
	 </section>
</Base>
