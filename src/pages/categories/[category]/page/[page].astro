---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import PortfolioGrid from "@/layouts/components/PortfolioGrid.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import type { GetStaticPathsOptions } from "astro";

export const getStaticPaths = async ({ paginate }: GetStaticPathsOptions) => {
  const { pagination } = config.settings;
  const allPosts = await getSinglePage("posts");
  const sortByDatePosts = sortByDate(allPosts);

  const categories = await getTaxonomy("posts", "categories");
  return categories
    .map((category) => {
      const filterByTags = taxonomyFilter(
        sortByDatePosts,
        "categories",
        category
      );
      return paginate(filterByTags, {
        params: { category: category || "" },
        pageSize: pagination,
      });
    })
    .flat();
};

const { page } = Astro.props;
const { category } = Astro.params;
---

<Base title={category}>
  <div class="section">
    <div class="container">
      <div class="row px-3">
        <div class="mx-auto px-0 lg:col-12">
          <h1 class="h2 mb-8">
            Posts related to <span class="text-primary">{category}</span> category
          </h1>
          <div class="space-y-10">
            <PortfolioGrid posts={page.data} />
            <Pagination
              section={`categories/${category}`}
              currentPage={page.currentPage}
              totalPages={page.lastPage}
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>
